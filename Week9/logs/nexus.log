```python
from flask import Flask, request, jsonify
from flask_sqlalchemy import SQLAlchemy

app = Flask(__name__)
app.config["SQLALCHEMY_DATABASE_URI"] = "mysql://user:password@localhost/db_name"
db = SQLAlchemy(app)

class Task(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    user_goals = db.Column(db.String(100), nullable=False)
    task_description = db.Column(db.String(200), nullable=False)
    input_data = db.Column(db.String(100), nullable=False)
    output_data = db.Column(db.String(100), nullable=False)

@app.route("/task", methods=["POST"])
def create_task():
    data = request.get_json()
    task = Task(
        user_goals=data["user_goals"],
        task_description=data["task_description"],
        input_data=data["input_data"],
        output_data=data["output_data"]
    )
    db.session.add(task)
    db.session.commit()
    return jsonify({"message": "Task created successfully"})

if __name__ == "__main__":
    app.run(debug=True)
```

